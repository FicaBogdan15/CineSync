@model IEnumerable<CineSync.Models.Movie>
@{
    ViewData["Title"] = "Manage Movies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
            <h2 class="mb-0">Manage Movies</h2>
        </div>
        <a asp-action="Create" class="btn btn-success">+ Add Movie</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No movies yet. Add your first movie!</div>
    }
    else
    {
        <table class="table table-striped shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Year</th>
                    <th>Category</th>
                    <th>PDF</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model)
                {
                    <tr>
                        <td class="fw-semibold">@movie.Title</td>
                        <td>@movie.Year</td>
                        <td>
                            <span class="badge bg-info text-dark">@movie.Category?.Name</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(movie.PdfPath))
                            {
                                <a href="@movie.PdfPath" target="_blank"
                                   class="btn btn-sm btn-outline-danger">📄 PDF</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@movie.MovieId"
                               class="btn btn-sm btn-warning">✏️ Edit</a>
                            <form asp-action="Delete" asp-route-id="@movie.MovieId"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this movie?')">
                                <button type="submit" class="btn btn-sm btn-danger">🗑 Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>