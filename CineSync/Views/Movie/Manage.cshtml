@model IEnumerable<CineSync.Models.Movie>
@{
    ViewData["Title"] = "Manage Movies";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var movieList = Model.ToList();
}

<div class="cs-page">
    @if (TempData["Success"] != null)
    {
        <div class="manage-alert manage-alert-success">
            ✓ @TempData["Success"]
        </div>
    }

    @if (TempData["ImportError"] != null)
    {
        <div class="manage-alert manage-alert-error">
            @TempData["ImportError"]
        </div>
    }

    <!-- Header -->
    <div class="manage-header">
        <a asp-action="Index" class="manage-back-btn">← Back</a>
        <div class="manage-title-wrap">
            <h1 class="manage-title">Manage Movies</h1>
        </div>
        <a asp-action="Create" class="manage-add-btn">⊕ + Add Movie</a>
    </div>

    <div class="manage-import-panel">
        <div>
            <div class="manage-import-kicker">TMDb Import</div>
            <h2 class="manage-import-title">Populate Netflix movies for Romania</h2>
            <p class="manage-import-text">
                Imports poster, title, release year, description, category, director, actors and cast roles from TMDb.
            </p>
        </div>

        <form asp-action="ImportTmdb" method="post" class="manage-import-form">
            @Html.AntiForgeryToken()

            <label class="manage-import-field">
                <span>Pages to import</span>
                <input type="number" name="maxPages" min="1" max="25" value="6" />
            </label>

            <label class="manage-import-check">
                <input type="checkbox" name="generatePdfs" value="true" />
                <span>Generate PDFs after import</span>
            </label>

            <button type="submit" class="manage-import-btn">Import From TMDb</button>
        </form>
    </div>

    <!-- Table -->
    @if (!movieList.Any())
    {
        <div class="cs-empty">
            <div class="cs-empty-icon">🎬</div>
            <div class="cs-empty-title">No Movies Yet</div>
            <p class="cs-empty-text">Add your first movie to get started.</p>
        </div>
    }
    else
    {
        <div class="manage-table">
            <!-- Table Header -->
            <div class="manage-table-header">
                <span>Title</span>
                <span>Year</span>
                <span>Category</span>
                <span>PDF</span>
                <span>Actions</span>
            </div>

            <!-- Rows -->
            @foreach (var movie in movieList)
            {
                <div class="manage-row">
                    <!-- Poster + Title -->
                    <div class="manage-movie-info">
                        <div class="manage-movie-thumb">
                            @if (!string.IsNullOrEmpty(movie.PosterPath))
                            {
                                <img src="@movie.PosterPath" alt="@movie.Title"
                                     loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span>🎬</span>
                            }
                        </div>
                        <span class="manage-movie-title">@movie.Title.ToUpper()</span>
                    </div>

                    <!-- Year -->
                    <div class="manage-cell">@movie.Year</div>

                    <!-- Category -->
                    <div class="manage-cell">
                        <span class="manage-category-badge">@(movie.Category?.Name?.ToUpper() ?? "—")</span>
                    </div>

                    <!-- PDF -->
                    <div class="manage-cell">
                        @if (!string.IsNullOrEmpty(movie.PdfPath))
                        {
                            <a href="@movie.PdfPath" target="_blank" class="manage-pdf-btn">
                                📄 PDF
                            </a>
                        }
                        else
                        {
                            <span style="color:var(--cs-muted);font-weight:700;font-size:0.82rem;">—</span>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="manage-actions">
                        <a asp-action="Edit" asp-route-id="@movie.MovieId"
                           class="manage-edit-btn">Edit</a>
                        <form asp-action="Delete" asp-route-id="@movie.MovieId"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Delete this movie?')">
                            <button type="submit" class="manage-delete-btn">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <!-- Footer bar -->
        <div class="manage-footer-bar">
            <span class="manage-count-label">
                Showing @movieList.Count movie@(movieList.Count != 1 ? "s" : "")
            </span>
        </div>
    }
</div>

<style>
    .manage-alert {
        margin-bottom: 24px;
        border: 3px solid #111;
        border-radius: 10px;
        padding: 16px 18px;
        box-shadow: 4px 4px 0 #111;
        font-family: "Archivo Black", sans-serif;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .manage-alert-success {
        background: var(--cs-lime);
        color: #000;
    }

    .manage-alert-error {
        background: #ff5c5c;
        color: #fff;
    }

    .manage-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
        gap: 20px;
    }

    .manage-back-btn {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: var(--cs-surface);
        color: var(--cs-text);
        border: 3px solid #111;
        border-radius: 8px;
        padding: 12px 20px;
        box-shadow: 4px 4px 0 #111;
        text-decoration: none;
        transition: transform 0.12s, box-shadow 0.12s;
        white-space: nowrap;
    }

    .manage-back-btn:hover {
        transform: translate(-2px,-2px);
        box-shadow: 6px 6px 0 #111;
        color: var(--cs-text);
    }

    .manage-title-wrap {
        background: var(--cs-yellow);
        border: 3px solid #111;
        border-radius: 10px;
        box-shadow: 6px 6px 0 #111;
        padding: 12px 32px;
    }

    .manage-title {
        font-family: "Archivo Black", sans-serif;
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        text-transform: uppercase;
        letter-spacing: -0.03em;
        color: #111;
        margin: 0;
    }

    .manage-add-btn {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: var(--cs-surface);
        color: var(--cs-text);
        border: 3px solid #111;
        border-radius: 8px;
        padding: 12px 20px;
        box-shadow: 4px 4px 0 #111;
        text-decoration: none;
        transition: transform 0.12s, box-shadow 0.12s;
        white-space: nowrap;
    }

    .manage-add-btn:hover {
        transform: translate(-2px,-2px);
        box-shadow: 6px 6px 0 #111;
        background: var(--cs-blue);
        color: #000;
    }

    .manage-import-panel {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 24px;
        align-items: center;
        margin-bottom: 32px;
        padding: 24px 26px;
        border: 3px solid #111;
        border-radius: 12px;
        box-shadow: 5px 5px 0 #111;
        background: var(--cs-surface);
    }

    .manage-import-kicker {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--cs-muted);
        margin-bottom: 8px;
    }

    .manage-import-title {
        font-family: "Archivo Black", sans-serif;
        font-size: clamp(1.3rem, 2vw, 1.8rem);
        text-transform: uppercase;
        letter-spacing: -0.03em;
        margin: 0 0 10px 0;
        color: var(--cs-text);
    }

    .manage-import-text {
        margin: 0;
        color: var(--cs-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 720px;
    }

    .manage-import-form {
        display: grid;
        gap: 14px;
        justify-self: end;
        width: min(100%, 320px);
    }

    .manage-import-field {
        display: grid;
        gap: 8px;
        font-family: "Archivo Black", sans-serif;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--cs-text);
    }

    .manage-import-field input {
        width: 100%;
        border: 3px solid #111;
        border-radius: 8px;
        padding: 12px 14px;
        background: #fff;
        color: #111;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        box-shadow: 3px 3px 0 #111;
    }

    .manage-import-check {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--cs-text);
        font-family: "Archivo Black", sans-serif;
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .manage-import-check input {
        width: 18px;
        height: 18px;
        accent-color: #111;
    }

    .manage-import-btn {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: var(--cs-pink);
        color: #000;
        border: 3px solid #111;
        border-radius: 8px;
        padding: 14px 18px;
        box-shadow: 4px 4px 0 #111;
        cursor: pointer;
        transition: transform 0.12s, box-shadow 0.12s;
    }

    .manage-import-btn:hover {
        transform: translate(-2px,-2px);
        box-shadow: 6px 6px 0 #111;
    }

    /* Table */
    .manage-table {
        border: 3px solid #111;
        border-radius: 12px;
        box-shadow: 5px 5px 0 #111;
        overflow: hidden;
        background: var(--cs-surface);
    }

    .manage-table-header {
        display: grid;
        grid-template-columns: 3fr 1fr 1.5fr 1fr 1.5fr;
        gap: 16px;
        background: #111;
        color: #fff;
        padding: 16px 24px;
        font-family: "Archivo Black", sans-serif;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .manage-row {
        display: grid;
        grid-template-columns: 3fr 1fr 1.5fr 1fr 1.5fr;
        gap: 16px;
        align-items: center;
        padding: 18px 24px;
        border-bottom: 2px solid #111;
        transition: background 0.12s;
    }

    .manage-row:last-child { border-bottom: none; }
    .manage-row:hover { background: var(--cs-surface-2); }

    .manage-movie-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .manage-movie-thumb {
        width: 52px;
        height: 52px;
        border: 2px solid #111;
        border-radius: 6px;
        overflow: hidden;
        background: var(--cs-surface-2);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .manage-movie-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .manage-movie-title {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: -0.01em;
        color: var(--cs-text);
    }

    .manage-cell {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.88rem;
        color: var(--cs-text);
    }

    .manage-category-badge {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: var(--cs-blue);
        color: #000;
        border: 2px solid #111;
        border-radius: 999px;
        padding: 4px 12px;
        box-shadow: 2px 2px 0 #111;
    }

    .manage-pdf-btn {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: #ff5c5c;
        color: #fff;
        border: 2px solid #111;
        border-radius: 6px;
        padding: 6px 12px;
        box-shadow: 2px 2px 0 #111;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.1s;
    }

    .manage-pdf-btn:hover {
        transform: translate(-1px,-1px);
        color: #fff;
    }

    .manage-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .manage-edit-btn {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: var(--cs-yellow);
        color: #000;
        border: 2px solid #111;
        border-radius: 6px;
        padding: 8px 14px;
        box-shadow: 3px 3px 0 #111;
        text-decoration: none;
        transition: transform 0.12s, box-shadow 0.12s;
    }

    .manage-edit-btn:hover {
        transform: translate(-2px,-2px);
        box-shadow: 5px 5px 0 #111;
        color: #000;
    }

    .manage-delete-btn {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        background: #ff5c5c;
        color: #fff;
        border: 2px solid #111;
        border-radius: 6px;
        padding: 8px 14px;
        box-shadow: 3px 3px 0 #111;
        cursor: pointer;
        transition: transform 0.12s, box-shadow 0.12s;
    }

    .manage-delete-btn:hover {
        transform: translate(-2px,-2px);
        box-shadow: 5px 5px 0 #111;
    }

    /* Footer bar */
    .manage-footer-bar {
        background: #111;
        color: #fff;
        border: 3px solid #111;
        border-radius: 10px;
        box-shadow: 4px 4px 0 #555;
        padding: 18px 28px;
        margin-top: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .manage-count-label {
        font-family: "Archivo Black", sans-serif;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--cs-yellow);
    }

    @@media (max-width: 900px) {
        .manage-table-header,
        .manage-row { grid-template-columns: 2fr 1fr 1fr 1fr; }
        .manage-table-header span:nth-child(4),
        .manage-row > div:nth-child(4) { display: none; }

        .manage-import-panel {
            grid-template-columns: 1fr;
        }

        .manage-import-form {
            justify-self: stretch;
            width: 100%;
        }
    }

    @@media (max-width: 600px) {
        .manage-header { flex-direction: column; align-items: stretch; }
        .manage-title-wrap { text-align: center; }
    }
</style>
