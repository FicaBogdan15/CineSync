@model IEnumerable<CineSync.Models.Movie>

@{
    ViewData["Title"] = "Movies";
    var searchResults = ViewBag.SearchResults as List<(CineSync.Models.Movie Movie, double Score)>;
    var averageRatings = ViewBag.AverageRatings as Dictionary<int, double>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Available Movies</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Manage" class="btn btn-danger">⚙️ Manage Movies</a>
        }
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">🔍</span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control" placeholder="Search by title, actor, director..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in (IEnumerable<CineSync.Models.Category>)ViewBag.Categories)
                    {
                        <option value="@cat.CategoryId"
                                selected="@(ViewBag.SelectedCategory == cat.CategoryId ? "selected" : null)">
                            @cat.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <div class="mt-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">✕ Clear search</a>
                <span class="text-muted ms-2 small">
                    Showing results for "<strong>@ViewBag.Search</strong>"
                    — @Model.Count() result(s) found
                </span>
            </div>
        }
    </form>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">No movies found.</div>
            </div>
        }
        else
        {
            @foreach (var movie in Model)
            {
                double? score = searchResults?.FirstOrDefault(r => r.Movie.MovieId == movie.MovieId).Score;
                var avgRating = averageRatings != null && averageRatings.ContainsKey(movie.MovieId)
                ? averageRatings[movie.MovieId]
                : 0.0;

                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm border-0">

                        <div class="position-relative">
                            @if (!string.IsNullOrEmpty(movie.PosterPath))
                            {
                                <img src="@movie.PosterPath" class="card-img-top"
                                     style="height:300px; object-fit:cover" alt="@movie.Title" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="height:300px">
                                    <span class="text-muted fs-1">🎬</span>
                                </div>
                            }

                            @if (avgRating > 0)
                            {
                                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 shadow">
                                    ⭐ @avgRating.ToString("F1")
                                </span>
                            }
                        </div>

                        <div class="card-body">
                            <h5 class="card-title text-truncate">@movie.Title</h5>

                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-info text-dark">@movie.Category?.Name</span>
                                <small class="text-muted">@movie.Year</small>
                            </div>

                            @if (score.HasValue)
                            {
                                <div class="mt-1 mb-1">
                                    <span class="badge bg-success bg-opacity-75 small">
                                        relevance: @score.Value.ToString("F3")
                                    </span>
                                </div>
                            }

                            <p class="card-text text-muted small mt-2"
                               style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                                @movie.Description
                            </p>
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3">
                            <a asp-action="Details" asp-route-id="@movie.MovieId"
                               class="btn btn-primary w-100 shadow-sm">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>