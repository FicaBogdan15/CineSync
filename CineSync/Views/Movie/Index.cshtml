@model IEnumerable<CineSync.Models.Movie>
@{
    ViewData["Title"] = "Movies";
    var searchResults = ViewBag.SearchResults as List<(CineSync.Models.Movie Movie, double Score)>;
    var hasSearch = !string.IsNullOrEmpty(ViewBag.Search as string);
    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="cs-page">
    @* Page Header *@
    <div class="cs-page-header">
        <h1 class="cs-page-title">
            <span class="cs-highlight">AVAIL</span>ABLE MOVIES
        </h1>
        <p class="cs-page-subtitle">Browse the full catalog - filter, search, discover.</p>
    </div>

    @* Search Bar *@
    <form asp-action="Index" method="get">
        <div class="cs-search-bar">
            <div class="cs-search-input-wrap position-relative">
                <span class="cs-search-icon">Search</span>
                <input type="text"
                       id="movieSearchInput"
                       name="search"
                       value="@ViewBag.Search"
                       class="cs-search-input"
                       placeholder="Search by title, actor, director..."
                       autocomplete="off" />
                <div id="movieSuggestionsBox" class="cs-suggestions-box d-none"></div>
            </div>
            <div class="cs-search-divider"></div>
            <select name="categoryId" class="cs-search-select">
                <option value="">All Categories</option>
                @foreach (var cat in (IEnumerable<CineSync.Models.Category>)ViewBag.Categories)
                {
                    <option value="@cat.CategoryId"
                            selected="@(ViewBag.SelectedCategory == cat.CategoryId ? "selected" : null)">
                        @cat.Name.ToUpper()
                    </option>
                }
            </select>
            <button type="submit" class="cs-search-btn">Search</button>
        </div>
    </form>

    @* Section Header *@
    <div class="cs-section-header">
        <div>
            @if (hasSearch)
            {
                <span class="cs-section-label">Search Results</span>
            }
            else
            {
                <span class="cs-section-label">All Movies</span>
            }
            <div class="cs-section-title">
                @if (hasSearch)
                {
                    @($"{Model.Count()} results for \"{ViewBag.Search}\"")
                }
                else
                {
                    @($"{Model.Count()} Movies In Catalog")
                }
            </div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Manage" class="cs-admin-btn">Manage Movies</a>
        }
    </div>

    @* Search info bar *@
    @if (hasSearch)
    {
        <div class="cs-search-info">
            <span class="cs-search-tag">@ViewBag.Search</span>
            <a asp-action="Index" class="cs-clear-btn">Clear Search</a>
            <span class="cs-result-count">@Model.Count() Results Found</span>
        </div>
    }

    @* Grid *@
    <div class="cs-movies-grid">
        @if (!Model.Any())
        {
            <div class="cs-empty">
                <div class="cs-empty-icon">Movie</div>
                <div class="cs-empty-title">No Movies Found</div>
                <p class="cs-empty-text">Try adjusting your search or category filter.</p>
            </div>
        }
        else
        {
            @foreach (var movie in Model)
            {
                double? score = searchResults?
                    .FirstOrDefault(r => r.Movie.MovieId == movie.MovieId).Score;

                <div class="cs-movie-card">
                    <div class="cs-movie-poster">
                        @if (!string.IsNullOrEmpty(movie.PosterPath))
                        {
                            <img src="@movie.PosterPath"
                                 alt="@movie.Title"
                                 loading="lazy"
                                 decoding="async"
                                 width="600"
                                 height="375"
                                 style="width:100%;height:100%;object-fit:cover;display:block;" />
                        }
                        else
                        {
                            <div class="cs-movie-poster-placeholder">Movie</div>
                        }
                    </div>

                    <div class="cs-movie-body">
                        <div class="cs-movie-meta">
                            <span class="cs-movie-category">@(movie.Category?.Name ?? "-")</span>
                            <span class="cs-movie-year">@movie.Year</span>
                        </div>
                        <div class="cs-movie-title">@movie.Title</div>
                        @if (!string.IsNullOrEmpty(movie.Description))
                        {
                            <div class="cs-movie-desc">@movie.Description</div>
                        }
                        @if (score.HasValue)
                        {
                            <span class="cs-movie-relevance">
                                Relevance @score.Value.ToString("F2")
                            </span>
                        }
                    </div>

                    <div class="cs-movie-footer">
                        <a asp-action="Details" asp-route-id="@movie.MovieId"
                           class="cs-view-btn">View Details</a>
                    </div>
                </div>
            }
        }
    </div>

    @if (totalPages > 1)
    {
        <div style="display:flex;justify-content:center;align-items:center;gap:8px;margin-top:36px;flex-wrap:wrap;">
            @if (currentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-categoryId="@ViewBag.SelectedCategory"
                   asp-route-search="@ViewBag.Search"
                   class="cs-nav-link">Prev</a>
            }
            else
            {
                <span class="cs-nav-link movie-page-disabled">Prev</span>
            }

            @for (int p = startPage; p <= endPage; p++)
            {
                <a asp-action="Index"
                   asp-route-page="@p"
                   asp-route-categoryId="@ViewBag.SelectedCategory"
                   asp-route-search="@ViewBag.Search"
                   class="cs-nav-link @(p == currentPage ? "active" : "")">@p</a>
            }

            @if (currentPage < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-categoryId="@ViewBag.SelectedCategory"
                   asp-route-search="@ViewBag.Search"
                   class="cs-nav-link">Next</a>
            }
            else
            {
                <span class="cs-nav-link movie-page-disabled">Next</span>
            }
        </div>
    }
</div>

<style>
    .movie-page-disabled {
        opacity: 0.45;
        pointer-events: none;
        border: 2px solid var(--cs-border);
    }
</style>
