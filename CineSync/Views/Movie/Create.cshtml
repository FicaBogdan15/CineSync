@model CineSync.Models.Movie
@{
    ViewData["Title"] = "Add Movie";
}

<div class="container mt-4" style="max-width:700px">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="Manage" class="btn btn-outline-secondary btn-sm me-3">← Back</a>
        <h2 class="mb-0">Add New Movie</h2>
    </div>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold">Title *</label>
            <input asp-for="Title" class="form-control" placeholder="Movie title" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Year</label>
                <input asp-for="Year" type="number" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Category</label>
                <select asp-for="CategoryId" class="form-select"
                        asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "Name"))">
                    <option value="">-- Select category --</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Brief movie description..."></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Poster URL</label>
            <input asp-for="PosterPath" class="form-control" placeholder="https://..." />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Director</label>
            <select asp-for="DirectorId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Directors, "DirectorId", "Name"))">
                <option value="">-- Select director --</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold border-bottom d-block pb-2">Cast</label>
            <div id="actorList"></div>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="addActor()">
                + Add Actor
            </button>
        </div>

        <hr />
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-success shadow-sm">💾 Save & Generate PDF</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const actors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    ((IEnumerable<CineSync.Models.Actor>)ViewBag.Actors)
                    .Select(a => new { id = a.ActorId, name = a.Name })
            ));

    function addActor() {
        const div = document.createElement('div');
        div.className = 'row g-2 mb-2 align-items-center actor-row shadow-sm p-2 bg-light rounded';
        div.innerHTML = `
            <div class="col-md-4">
                <select name="selectedActors" class="form-select form-select-sm">
                    <option value="">-- Actor --</option>
                    ${actors.map(a => `<option value="${a.id}">${a.name}</option>`).join('')}
                </select>
            </div>
            <div class="col-md-4">
                <input type="text" name="characterNames" class="form-control form-control-sm" placeholder="Character name" />
            </div>
            <div class="col-md-3">
                <select name="roleTypes" class="form-select form-select-sm">
                    <option value="Lead">Lead</option>
                    <option value="Support" selected>Support</option>
                </select>
            </div>
            <div class="col-md-1 text-end">
                <button type="button" class="btn btn-sm btn-outline-danger border-0"
                        onclick="this.closest('.actor-row').remove()">✕</button>
            </div>
        `;
        document.getElementById('actorList').appendChild(div);
    }
</script>
}