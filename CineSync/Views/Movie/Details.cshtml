@model CineSync.Models.Movie

@{
    ViewData["Title"] = Model.Title;
    double? averageRating = ViewBag.AverageRating as double?;
    int reviewCount = ViewBag.ReviewCount != null ? (int)ViewBag.ReviewCount : 0;
    bool userHasReviewed = ViewBag.UserHasReviewed != null && (bool)ViewBag.UserHasReviewed;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4 mb-4">
            @if (!string.IsNullOrEmpty(Model.PosterPath))
            {
                <img src="@Model.PosterPath" class="img-fluid rounded shadow"
                     alt="@Model.Title" style="max-height:500px;width:100%;object-fit:cover" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center shadow"
                     style="height:400px">
                    <span class="text-muted fs-1">🎬</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.PdfPath))
            {
                <a href="@Model.PdfPath" target="_blank"
                   class="btn btn-outline-danger w-100 mt-3 shadow-sm">
                    📄 View Movie Sheet (PDF)
                </a>
            }
        </div>

        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-start">
                <h1 class="fw-bold">@Model.Title</h1>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.MovieId"
                       class="btn btn-warning btn-sm">✏️ Edit</a>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap mb-3">
                <span class="badge bg-info text-dark fs-6">@Model.Category?.Name</span>
                <span class="badge bg-secondary fs-6">@Model.Year</span>

                @if (averageRating.HasValue)
                {
                    <span class="badge bg-warning text-dark fs-6">
                        ⭐ @averageRating.Value.ToString("F1") / 10
                    </span>
                    <span class="badge bg-dark fs-6">
                        @reviewCount review(s)
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-dark border fs-6">
                        No ratings yet
                    </span>
                }
            </div>

            @if (Model.Director != null)
            {
                <p class="mb-2">
                    <strong>🎬 Director:</strong> @Model.Director.Name
                    <span class="text-muted small ms-2">(@Model.Director.AwardsCount awards)</span>
                </p>
            }

            <hr />

            <h5>Description</h5>
            <p class="text-muted">@(Model.Description ?? "No description available.")</p>

            @if (Model.Casts != null && Model.Casts.Any())
            {
                <hr />
                <h5>Cast</h5>
                <div class="row g-2 mt-1">
                    @foreach (var cast in Model.Casts)
                    {
                        <div class="col-md-4">
                            <div class="card border-0 bg-light p-2 rounded shadow-sm">
                                <div class="fw-semibold">@cast.Actor?.Name</div>
                                <small class="text-muted">
                                    as <em>@cast.CharacterName</em>
                                    <span class="badge @(cast.RoleType == "Lead" ? "bg-warning text-dark" : "bg-secondary") ms-1">
                                        @cast.RoleType
                                    </span>
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-lg-7">
            <h4>Reviews</h4>

            @if (TempData["ReviewSuccess"] != null)
            {
                <div class="alert alert-success mt-3">@TempData["ReviewSuccess"]</div>
            }

            @if (TempData["ReviewError"] != null)
            {
                <div class="alert alert-danger mt-3">@TempData["ReviewError"]</div>
            }

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="mt-3">
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.Date))
                    {
                        <div class="card mb-3 shadow-sm border-0 bg-light">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>@(review.User?.UserName ?? "Anonymous")</strong>
                                    <span class="badge bg-warning text-dark">
                                        ⭐ @review.Rating / 10
                                    </span>
                                </div>

                                <p class="mb-2">@review.ReviewText</p>

                                <small class="text-muted">
                                    @review.Date.ToString("dd MMM yyyy, HH:mm")
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    No reviews yet. Be the first to review this movie.
                </div>
            }
        </div>

        <div class="col-lg-5">
            <h4>Leave a Review</h4>

            @if (!User.Identity!.IsAuthenticated)
            {
                <div class="alert alert-warning mt-3">
                    Please log in to leave a review.
                </div>
            }
            else if (userHasReviewed)
            {
                <div class="alert alert-secondary mt-3">
                    You have already reviewed this movie.
                </div>
            }
            else
            {
                <form asp-action="AddReview" method="post" class="mt-3">
                    <input type="hidden" name="movieId" value="@Model.MovieId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rating (1 - 10)</label>
                        <select name="rating" class="form-select" required>
                            <option value="">Select rating</option>
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comment</label>
                        <textarea name="reviewText" class="form-control" rows="5"
                              placeholder="Write your opinion about this movie..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Submit Review
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">← Back to Movies</a>
    </div>
</div>