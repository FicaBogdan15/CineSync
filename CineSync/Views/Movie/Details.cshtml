@using CineSync.ViewModels
@model CineSync.Models.Movie

@{
    ViewData["Title"] = Model.Title;
    double? averageRating = ViewBag.AverageRating as double?;
    int reviewCount = ViewBag.ReviewCount != null ? (int)ViewBag.ReviewCount : 0;
    bool userHasReviewed = ViewBag.UserHasReviewed != null && (bool)ViewBag.UserHasReviewed;
    bool isInWatchList = ViewBag.IsInWatchList != null && (bool)ViewBag.IsInWatchList;
    bool isWatched = ViewBag.IsWatched != null && (bool)ViewBag.IsWatched;
    bool? userReaction = ViewBag.UserReaction as bool?;
    var similarMovies = ViewBag.SimilarMovies as IEnumerable<SimilarMovieViewModel>;
}

<div class="cs-max-1400">
    <div class="cs-details-layout">
        <div>
            @if (!string.IsNullOrEmpty(Model.PosterPath))
            {
                <div class="cs-image-shell">
                    <img src="@Model.PosterPath"
                         class="cs-poster cs-poster-md cs-poster-plain"
                         alt="@Model.Title"
                         width="560"
                         height="420"
                         loading="lazy"
                         decoding="async" />
                </div>
            }
            else
            {
                <div class="cs-poster-placeholder cs-poster-md">
                    <span class="fs-1">Movie</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.PdfPath))
            {
                <a href="@Model.PdfPath" target="_blank"
                   class="btn cs-btn cs-btn-dislike w-100 mt-3">
                    View Movie Sheet
                </a>
            }
        </div>

        <div class="cs-panel">
            <div class="d-flex justify-content-between align-items-start">
                <h1 class="mb-0">@Model.Title</h1>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.MovieId"
                       class="btn cs-btn cs-btn-watchlist">Edit</a>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap mb-3">
                <span class="cs-badge cs-badge-category">@Model.Category?.Name</span>
                <span class="cs-badge cs-badge-meta">@Model.Year</span>

                @if (averageRating.HasValue)
                {
                    <span class="cs-badge cs-badge-rating">
                        Rating @averageRating.Value.ToString("F1") / 10
                    </span>
                    <span class="cs-badge cs-badge-dark">
                        @reviewCount review(s)
                    </span>
                }
                else
                {
                    <span class="cs-badge cs-badge-meta">
                        No ratings yet
                    </span>
                }
            </div>

            @if (Model.Director != null)
            {
                <p class="mb-2">
                    <strong>Director:</strong> @Model.Director.Name
                    <span class="cs-muted small ms-2">(@Model.Director.AwardsCount awards)</span>
                </p>
            }

            <div class="cs-divider"></div>

            <h5>Description</h5>
            <p class="cs-muted">@(Model.Description ?? "No description available.")</p>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="mt-4">
                    <h5 class="mb-3">Your Reaction</h5>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (userReaction == true)
                        {
                            <span class="cs-badge cs-badge-liked">Liked</span>
                        }
                        else if (userReaction == false)
                        {
                            <span class="cs-badge cs-badge-disliked">Disliked</span>
                        }
                        else
                        {
                            <span class="cs-badge cs-badge-meta">No reaction yet</span>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <form asp-action="Like" method="post" class="d-inline">
                            <input type="hidden" name="movieId" value="@Model.MovieId" />
                            <button type="submit" class="btn cs-btn cs-btn-like">
                                Like
                            </button>
                        </form>

                        <form asp-action="Dislike" method="post" class="d-inline">
                            <input type="hidden" name="movieId" value="@Model.MovieId" />
                            <button type="submit" class="btn cs-btn cs-btn-dislike">
                                Dislike
                            </button>
                        </form>

                        @if (isInWatchList)
                        {
                            <form asp-controller="WatchList" asp-action="Remove" method="post" class="d-inline">
                                <input type="hidden" name="movieId" value="@Model.MovieId" />
                                <button type="submit" class="btn cs-btn cs-btn-dislike">
                                    Remove from Watchlist
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Recommendation" asp-action="AddToWatchList" method="post" class="d-inline">
                                <input type="hidden" name="movieId" value="@Model.MovieId" />
                                <button type="submit" class="btn cs-btn cs-btn-watchlist">
                                    Add to Watchlist
                                </button>
                            </form>
                        }

                        @if (isWatched)
                        {
                            <form asp-controller="WatchList" asp-action="MarkToWatch" method="post" class="d-inline">
                                <input type="hidden" name="movieId" value="@Model.MovieId" />
                                <button type="submit" class="btn cs-btn cs-btn-neutral">
                                    Move Back to To Watch
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="WatchList" asp-action="MarkWatched" method="post" class="d-inline">
                                <input type="hidden" name="movieId" value="@Model.MovieId" />
                                <button type="submit" class="btn cs-btn cs-btn-watched">
                                    Mark as Watched
                                </button>
                            </form>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @if (isInWatchList)
                        {
                            <span class="cs-badge cs-badge-watchlist">In Watchlist</span>
                        }

                        @if (isWatched)
                        {
                            <span class="cs-badge cs-badge-watched">Watched</span>
                        }
                    </div>
                </div>
            }

            @if (Model.Casts != null && Model.Casts.Any())
            {
                <div class="cs-divider"></div>
                <h5>Cast</h5>
                <div class="row g-2 mt-1">
                    @foreach (var cast in Model.Casts)
                    {
                        <div class="col-md-4">
                            <div class="cs-card p-3 h-100">
                                <div class="fw-semibold">@cast.Actor?.Name</div>
                                <small class="cs-muted">
                                    as <em>@cast.CharacterName</em>
                                    <span class="cs-badge @(cast.RoleType == "Lead" ? "cs-badge-rating" : "cs-badge-meta") ms-1">
                                        @cast.RoleType
                                    </span>
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="cs-divider"></div>

    <div class="row">
        <div class="col-lg-7">
            <h4>Reviews</h4>

            @if (TempData["ReviewSuccess"] != null)
            {
                <div class="alert alert-success mt-3">@TempData["ReviewSuccess"]</div>
            }

            @if (TempData["ReviewError"] != null)
            {
                <div class="alert alert-danger mt-3">@TempData["ReviewError"]</div>
            }

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="mt-3">
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.Date))
                    {
                        <div class="cs-card p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong>@(review.User?.UserName ?? "Anonymous")</strong>
                                    <span class="cs-badge cs-badge-rating">
                                        Rating @review.Rating / 10
                                    </span>
                                </div>

                                <p class="mb-2">@review.ReviewText</p>

                                <small class="cs-muted">
                                    @review.Date.ToString("dd MMM yyyy, HH:mm")
                                </small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    No reviews yet. Be the first to review this movie.
                </div>
            }
        </div>

        <div class="col-lg-5">
            <h4>Leave a Review</h4>

            @if (!User.Identity!.IsAuthenticated)
            {
                <div class="alert alert-warning mt-3">
                    Please log in to leave a review.
                </div>
            }
            else if (userHasReviewed)
            {
                <div class="alert alert-secondary mt-3">
                    You have already reviewed this movie.
                </div>
            }
            else
            {
                <form asp-action="AddReview" method="post" class="mt-3">
                    <input type="hidden" name="movieId" value="@Model.MovieId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rating (1 - 10)</label>
                        <select name="rating" class="form-select" required>
                            <option value="">Select rating</option>
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comment</label>
                        <textarea name="reviewText" class="form-control" rows="5"
                              placeholder="Write your opinion about this movie..." required></textarea>
                    </div>

                    <button type="submit" class="btn cs-btn cs-btn-blue w-100">
                        Submit Review
                    </button>
                </form>
            }
        </div>
    </div>

    @if (similarMovies != null && similarMovies.Any())
    {
        <hr class="my-4" />

        <div class="mt-4">
            <h4>Similar Movies</h4>
            <div class="row g-4 mt-1">
                @foreach (var similar in similarMovies)
                {
                    <div class="col-md-3">
                        <div class="cs-card p-0 overflow-hidden h-100">
                            @if (!string.IsNullOrEmpty(similar.PosterPath))
                            {
                                <img src="@similar.PosterPath"
                                     alt="@similar.Title"
                                     class="cs-poster cs-poster-sm cs-poster-plain"
                                     loading="lazy"
                                     decoding="async" />
                            }
                            else
                            {
                                <div class="cs-poster-placeholder cs-poster-sm rounded-0 border-0 shadow-none">
                                    <span class="fs-3">Movie</span>
                                </div>
                            }

                            <div class="p-3 d-flex flex-column">
                                <h6 class="fw-bold mb-2">@similar.Title</h6>

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="cs-badge cs-badge-category">@similar.CategoryName</span>
                                    <span class="cs-badge cs-badge-meta">@similar.Year</span>
                                </div>

                                <div class="mb-3">
                                    <span class="cs-badge cs-badge-rating">
                                        Similarity @similar.SimilarityScore.ToString("F2")
                                    </span>
                                </div>

                                <a asp-action="Details"
                                   asp-route-id="@similar.MovieId"
                                   class="btn cs-btn cs-btn-blue w-100 mt-auto">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn cs-btn cs-btn-neutral">Back to Movies</a>
    </div>
</div>
