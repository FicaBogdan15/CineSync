@model CineSync.ViewModels.RecommendationViewModel

@{
    ViewData["Title"] = "Recommendations";
}

<div class="cs-max-1400">
    <div class="mb-4">
        <h2>Recommendations</h2>
        <p class="cs-muted mb-0">Discover movies tailored for you.</p>
    </div>

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Movie == null)
    {
        <div class="alert alert-warning">
            No recommendations are available right now.
        </div>

        <a asp-controller="Movie" asp-action="Index" class="btn cs-btn cs-btn-blue">
            Browse Movies
        </a>
    }
    else
    {
        <div class="cs-recommendation-layout">
            <div class="d-flex flex-column gap-4">
                <div>
                    @if (!string.IsNullOrEmpty(Model.Movie.PosterPath))
                    {
                        <div class="cs-image-shell">
                            <img src="@Model.Movie.PosterPath"
                                 alt="@Model.Movie.Title"
                                 class="cs-poster cs-poster-md cs-poster-plain"
                                 width="560"
                                 height="420"
                                 loading="lazy"
                                 decoding="async" />
                        </div>
                    }
                    else
                    {
                        <div class="cs-poster-placeholder cs-poster-md">
                            <span class="display-3">Movie</span>
                        </div>
                    }
                </div>

                <div class="cs-card p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="mb-0">@Model.Movie.Title</h3>
                            <span class="cs-badge cs-badge-dark">
                                @(Model.CurrentIndex + 1) / @Model.TotalRecommendations
                            </span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="cs-badge cs-badge-category">@Model.Movie.Category?.Name</span>
                            <span class="cs-badge cs-badge-meta">@Model.Movie.Year</span>

                            @if (Model.AverageRating.HasValue)
                            {
                                <span class="cs-badge cs-badge-rating">
                                    Rating @Model.AverageRating.Value.ToString("F1") / 10
                                </span>
                            }
                            else
                            {
                                <span class="cs-badge cs-badge-meta">
                                    No rating yet
                                </span>
                            }
                        </div>

                        <p class="mb-2">
                            <strong>Director:</strong>
                            @(Model.Movie.Director?.Name ?? "Unknown")
                        </p>

                        <p class="mb-2">
                            <strong>Reviews:</strong> @Model.ReviewCount
                        </p>

                        <p class="mb-3">
                            <strong>Why recommended?</strong><br />
                            <span class="cs-muted">@Model.Reason</span>
                        </p>

                        <p class="cs-muted flex-grow-1" style="min-height: 120px;">
                            @(string.IsNullOrWhiteSpace(Model.Movie.Description)
                                ? "No description available."
                                : Model.Movie.Description)
                        </p>

                        <div class="mb-3">
                            @if (Model.UserReaction == true)
                            {
                                <span class="cs-badge cs-badge-liked me-2">Liked</span>
                            }
                            else if (Model.UserReaction == false)
                            {
                                <span class="cs-badge cs-badge-disliked me-2">Disliked</span>
                            }

                            @if (Model.IsInWatchList)
                            {
                                <span class="cs-badge cs-badge-watchlist me-2">In Watchlist</span>
                            }

                            @if (Model.IsWatched)
                            {
                                <span class="cs-badge cs-badge-watched">Watched</span>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <form asp-action="Like" method="post">
                                <input type="hidden" name="movieId" value="@Model.Movie.MovieId" />
                                <input type="hidden" name="currentIndex" value="@Model.CurrentIndex" />
                                <button type="submit" class="btn cs-btn cs-btn-like w-100">
                                    Like
                                </button>
                            </form>

                            <form asp-action="Dislike" method="post">
                                <input type="hidden" name="movieId" value="@Model.Movie.MovieId" />
                                <input type="hidden" name="currentIndex" value="@Model.CurrentIndex" />
                                <button type="submit" class="btn cs-btn cs-btn-dislike w-100">
                                    Dislike
                                </button>
                            </form>

                            @if (!Model.IsInWatchList)
                            {
                                <form asp-action="AddToWatchList" method="post">
                                    <input type="hidden" name="movieId" value="@Model.Movie.MovieId" />
                                    <input type="hidden" name="currentIndex" value="@Model.CurrentIndex" />
                                    <button type="submit" class="btn cs-btn cs-btn-watchlist w-100">
                                        Add to Watchlist
                                    </button>
                                </form>
                            }

                            @if (!Model.IsWatched)
                            {
                                <form asp-action="MarkWatched" method="post">
                                    <input type="hidden" name="movieId" value="@Model.Movie.MovieId" />
                                    <input type="hidden" name="currentIndex" value="@Model.CurrentIndex" />
                                    <button type="submit" class="btn cs-btn cs-btn-watched w-100">
                                        Mark as Watched
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="MarkToWatch" method="post">
                                    <input type="hidden" name="movieId" value="@Model.Movie.MovieId" />
                                    <input type="hidden" name="currentIndex" value="@Model.CurrentIndex" />
                                    <button type="submit" class="btn cs-btn cs-btn-neutral w-100">
                                        Move Back to To-Watch
                                    </button>
                                </form>
                            }

                            <a asp-controller="Movie"
                               asp-action="Details"
                               asp-route-id="@Model.Movie.MovieId"
                               class="btn cs-btn cs-btn-blue w-100">
                                View Details
                            </a>

                            <a asp-action="Next"
                               asp-route-currentIndex="@Model.CurrentIndex"
                               class="btn cs-btn cs-btn-dark w-100">
                                Next
                            </a>
                        </div>
                </div>
            </div>

            <div class="cs-card p-0 overflow-hidden">
                    @if (!string.IsNullOrEmpty(Model.Movie.PosterPath))
                    {
                        <div class="cs-image-shell rounded-0">
                            <img src="@Model.Movie.PosterPath"
                                 alt="@Model.Movie.Title"
                                 class="cs-poster cs-poster-lg cs-poster-plain"
                                 width="1000"
                                 height="760"
                                 loading="lazy"
                                 decoding="async" />
                        </div>
                    }
                    else
                    {
                        <div class="cs-poster-placeholder cs-poster-lg rounded-0 border-0 shadow-none">
                            <div class="text-center">
                                <div class="display-1 cs-muted mb-3">Movie</div>
                                <h4 class="cs-muted">Trailer placeholder area</h4>
                                <p class="cs-muted mb-0">
                                    This section can later be replaced with a trailer or video preview.
                                </p>
                            </div>
                        </div>
                    }
            </div>
        </div>
    }
</div>
