@model CineSync.Models.Cart?

@{
    ViewData["Title"] = "My Cart";
}

<div class="container mt-4" style="max-width:700px">
    <h2>🛒 My Cart</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model == null || !Model.CartItems.Any())
    {
        <div class="alert alert-info">Your cart is empty.</div>
        <a asp-action="Index" class="btn btn-primary">View Subscriptions</a>
    }
    else
    {
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Platform</th>
                    <th>Subscription Type</th>
                    <th>Video Quality</th>
                    <th>Price / Month</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td>@item.Subscription?.Platform?.Name</td>
                        <td>@item.Subscription?.Type</td>
                        <td>@item.Subscription?.VideoQuality</td>
                        <td>@item.Subscription?.MonthlyPrice lei</td>
                        <td>
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr class="table-light fw-bold">
                    <td colspan="3">Total Monthly Cost:</td>
                    <td colspan="2">
                        @Model.CartItems.Sum(ci => ci.Subscription?.MonthlyPrice ?? 0) lei
                    </td>
                </tr>
            </tfoot>
        </table>

        <form asp-action="Checkout" method="post">
            <button type="submit" class="btn btn-success"
                    onclick="return confirm('Confirm your order?')">
                Checkout
            </button>

            <a asp-action="Index" class="btn btn-secondary ms-2">
                Continue Shopping
            </a>
        </form>
    }
</div>