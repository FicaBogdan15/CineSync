@model CineSync.Models.Subscription
@{
    ViewData["Title"] = "Editează Abonament";
}

<div class="container mt-4" style="max-width:500px">
    <h2>Editează Abonament</h2>
    <form asp-action="Edit" method="post">
        <input asp-for="SubscriptionId" type="hidden" />
        <div class="mb-3">
            <label class="form-label">Platformă</label>
            <select asp-for="PlatformId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Platforms, "PlatformId", "Name"))">
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Tip</label>
            <input asp-for="Type" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Preț lunar (lei)</label>
            <input asp-for="MonthlyPrice" type="number" step="0.01" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Calitate video</label>
            <input asp-for="VideoQuality" class="form-control" />
        </div>
        <button type="submit" class="btn btn-warning">Salvează</button>
        <a asp-action="Manage" class="btn btn-secondary ms-2">Anulează</a>
    </form>
</div>