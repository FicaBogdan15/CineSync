<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineSync</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="cs-navbar">
            <a class="cs-brand" asp-area="" asp-controller="Home" asp-action="Index">CineSync</a>

            <ul class="cs-nav-links">
                <li>
                    <a class="cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li>
                    <a class="cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movie" ? "active" : "")"
                       asp-controller="Movie" asp-action="Index">Movies</a>
                </li>
                <li>
                    <a class="cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subscription" ? "active" : "")"
                       asp-controller="Subscription" asp-action="Index">Subscriptions</a>
                </li>
                <li>
                    <a class="cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Recommendation" ? "active" : "")"
                       asp-controller="Recommendation" asp-action="Index">Recommendations</a>
                </li>
                <li>
                    <a class="cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "WatchList" ? "active" : "")"
                       asp-controller="WatchList" asp-action="Index">Watchlist</a>
                </li>
                <li>
                    <a class="cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Statistics" ? "active" : "")"
                       asp-controller="Statistics" asp-action="Index">Stats</a>
                </li>
            </ul>

            <div class="cs-nav-right">
                <div class="dropdown">
                    <button class="user-bubble dropdown-toggle" type="button"
                            id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="material-symbols-outlined">person</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end cs-dropdown-menu" aria-labelledby="userMenu">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main>@RenderBody()</main>
    </div>

    <footer class="cs-footer">
        <span class="cs-footer-brand">CineSync</span>
        <span class="cs-footer-copy">&copy; 2026 CineSync - All rights reserved</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/image-loading.js" asp-append-version="true"></script>
    <script src="~/js/movie-autocomplete.js" asp-append-version="true"></script>
    <script>
        (function () {
            if (localStorage.getItem('theme') === 'dark') {
                document.body.classList.add('dark-mode');
            }
        })();

        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('themeToggle');
            if (!btn) return;

            function updateBtn() {
                const isDark = document.body.classList.contains('dark-mode');
                btn.textContent = isDark ? 'Light' : 'Dark';
            }

            updateBtn();

            btn.addEventListener('click', function () {
                document.body.classList.toggle('dark-mode');
                localStorage.setItem('theme',
                    document.body.classList.contains('dark-mode') ? 'dark' : 'light');
                updateBtn();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
