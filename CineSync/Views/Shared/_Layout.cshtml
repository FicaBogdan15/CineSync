<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineSync</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/brite/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="~/css/cinesync-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg cs-navbar mb-4">
            <div class="container-fluid px-4 px-lg-5">
                <a class="navbar-brand cs-brand" asp-area="" asp-controller="Home" asp-action="Index">CineSync</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1 gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movie" ? "active" : "")" asp-area="" asp-controller="Movie" asp-action="Index">Movies</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subscription" ? "active" : "")" asp-controller="Subscription" asp-action="Index">Subscriptions</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Recommendation" ? "active" : "")" asp-controller="Recommendation" asp-action="Index">Recommendations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link cs-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "WatchList" ? "active" : "")" asp-controller="WatchList" asp-action="Index">Watchlist</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <button id="themeToggle" class="btn cs-btn cs-btn-neutral" type="button">Theme</button>
                        <div class="dropdown">
                            <button class="user-bubble dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="material-symbols-outlined">person</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow cs-dropdown-menu" aria-labelledby="userMenu">
                            <partial name="_LoginPartial" />
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 px-lg-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer cs-footer mt-5">
        <div class="container text-center py-3">
            &copy; 2026 - CineSync - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/image-loading.js" asp-append-version="true"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/movie-autocomplete.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
