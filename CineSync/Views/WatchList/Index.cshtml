@model List<CineSync.Models.WatchListItem>

@{
    ViewData["Title"] = "My Watchlist";

    var toWatch = Model.Where(i => !i.IsWatched).ToList();
    var watched = Model.Where(i => i.IsWatched).ToList();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Watchlist</h2>
            <p class="text-muted mb-0">Keep track of movies you want to watch and those you have already seen.</p>
        </div>
        <a asp-controller="Recommendation" asp-action="Index" class="btn btn-outline-primary">
            Back to Recommendations
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your watchlist is empty.
        </div>

        <a asp-controller="Recommendation" asp-action="Index" class="btn btn-primary">
            Discover Recommendations
        </a>
    }
    else
    {
        <div class="mb-5">
            <h3 class="fw-bold mb-3">To Watch</h3>

            @if (!toWatch.Any())
            {
                <div class="alert alert-light border">
                    No movies in your To Watch section.
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in toWatch)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                @if (!string.IsNullOrEmpty(item.Movie?.PosterPath))
                                {
                                    <img src="@item.Movie.PosterPath"
                                         class="card-img-top"
                                         alt="@item.Movie?.Title"
                                         style="height: 320px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light"
                                         style="height: 320px;">
                                        <span class="display-4 text-muted">Movie</span>
                                    </div>
                                }

                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold mb-0">@item.Movie?.Title</h5>
                                        <span class="badge bg-warning text-dark">To Watch</span>
                                    </div>

                                    <div class="mb-2">
                                        <span class="badge bg-info text-dark me-1">@item.Movie?.Category?.Name</span>
                                        <span class="badge bg-secondary">@item.Movie?.Year</span>
                                    </div>

                                    <p class="text-muted small mb-3">
                                        @(string.IsNullOrWhiteSpace(item.Movie?.Description)
                                            ? "No description available."
                                            : item.Movie.Description.Length > 120
                                                ? item.Movie.Description.Substring(0, 120) + "..."
                                                : item.Movie.Description)
                                    </p>

                                    <div class="mt-auto d-grid gap-2">
                                        <form asp-action="MarkWatched" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn btn-dark w-100">
                                                Mark as Watched
                                            </button>
                                        </form>

                                        <a asp-controller="Movie"
                                           asp-action="Details"
                                           asp-route-id="@item.MovieId"
                                           class="btn btn-outline-primary w-100">
                                            View Details
                                        </a>

                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                Remove from Watchlist
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="card-footer bg-white text-muted small">
                                    Added on @item.AddedAt.ToString("dd MMM yyyy")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mb-4">
            <h3 class="fw-bold mb-3">Watched</h3>

            @if (!watched.Any())
            {
                <div class="alert alert-light border">
                    No watched movies yet.
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in watched)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card shadow-sm border-0 h-100">
                                @if (!string.IsNullOrEmpty(item.Movie?.PosterPath))
                                {
                                    <img src="@item.Movie.PosterPath"
                                         class="card-img-top"
                                         alt="@item.Movie?.Title"
                                         style="height: 320px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light"
                                         style="height: 320px;">
                                        <span class="display-4 text-muted">Movie</span>
                                    </div>
                                }

                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold mb-0">@item.Movie?.Title</h5>
                                        <span class="badge bg-dark">Watched</span>
                                    </div>

                                    <div class="mb-2">
                                        <span class="badge bg-info text-dark me-1">@item.Movie?.Category?.Name</span>
                                        <span class="badge bg-secondary">@item.Movie?.Year</span>
                                    </div>

                                    <p class="text-muted small mb-3">
                                        @(string.IsNullOrWhiteSpace(item.Movie?.Description)
                                            ? "No description available."
                                            : item.Movie.Description.Length > 120
                                                ? item.Movie.Description.Substring(0, 120) + "..."
                                                : item.Movie.Description)
                                    </p>

                                    <div class="mt-auto d-grid gap-2">
                                        <form asp-action="MarkToWatch" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn btn-outline-dark w-100">
                                                Move Back to To Watch
                                            </button>
                                        </form>

                                        <a asp-controller="Movie"
                                           asp-action="Details"
                                           asp-route-id="@item.MovieId"
                                           class="btn btn-outline-primary w-100">
                                            View Details
                                        </a>

                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                Remove from Watchlist
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="card-footer bg-white text-muted small">
                                    Watched on @(item.WatchedAt?.ToString("dd MMM yyyy") ?? "-")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
