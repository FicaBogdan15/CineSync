@model List<CineSync.Models.WatchListItem>

@{
    ViewData["Title"] = "My Watchlist";

    var toWatch = Model.Where(i => !i.IsWatched).ToList();
    var watched = Model.Where(i => i.IsWatched).ToList();
}

<div class="cs-max-1400">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">My Watchlist</h2>
            <p class="cs-muted mb-0">Keep track of movies you want to watch and those you have already seen.</p>
        </div>
        <a asp-controller="Recommendation" asp-action="Index" class="btn cs-btn cs-btn-neutral">
            Back to Recommendations
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your watchlist is empty.
        </div>

        <a asp-controller="Recommendation" asp-action="Index" class="btn cs-btn cs-btn-blue">
            Discover Recommendations
        </a>
    }
    else
    {
        <div class="mb-5">
            <h3 class="fw-bold mb-3">To Watch</h3>

            @if (!toWatch.Any())
            {
                <div class="alert alert-light border">
                    No movies in your To Watch section.
                </div>
            }
            else
            {
                <div class="cs-grid-movies">
                    @foreach (var item in toWatch)
                    {
                        <div>
                            <div class="cs-card movie-card p-0 overflow-hidden h-100">
                                @if (!string.IsNullOrEmpty(item.Movie?.PosterPath))
                                {
                                    <div class="cs-image-shell">
                                        <img src="@item.Movie.PosterPath"
                                             class="cs-poster cs-poster-sm cs-poster-plain"
                                             alt="@item.Movie?.Title"
                                             width="400"
                                             height="320"
                                             loading="lazy"
                                             decoding="async" />
                                    </div>
                                }
                                else
                                {
                                    <div class="cs-poster-placeholder cs-poster-sm rounded-0 border-0 shadow-none">
                                        <span class="display-4">Movie</span>
                                    </div>
                                }

                                <div class="p-4 d-flex flex-column h-100">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0">@item.Movie?.Title</h5>
                                        <span class="cs-badge cs-badge-watchlist">To Watch</span>
                                    </div>

                                    <div class="mb-2">
                                        <span class="cs-badge cs-badge-category me-1">@item.Movie?.Category?.Name</span>
                                        <span class="cs-badge cs-badge-meta">@item.Movie?.Year</span>
                                    </div>

                                    <p class="cs-muted small mb-3 cs-line-clamp-4">
                                        @(string.IsNullOrWhiteSpace(item.Movie?.Description)
                                            ? "No description available."
                                            : item.Movie.Description.Length > 120
                                                ? item.Movie.Description.Substring(0, 120) + "..."
                                                : item.Movie.Description)
                                    </p>

                                    <div class="mt-auto d-grid gap-2">
                                        <form asp-action="MarkWatched" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn cs-btn cs-btn-watched w-100">
                                                Mark as Watched
                                            </button>
                                        </form>

                                        <a asp-controller="Movie"
                                           asp-action="Details"
                                           asp-route-id="@item.MovieId"
                                           class="btn cs-btn cs-btn-blue w-100">
                                            View Details
                                        </a>

                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn cs-btn cs-btn-dislike w-100">
                                                Remove from Watchlist
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="p-4 pt-0 cs-muted small">
                                    Added on @item.AddedAt.ToString("dd MMM yyyy")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mb-4">
            <h3 class="fw-bold mb-3">Watched</h3>

            @if (!watched.Any())
            {
                <div class="alert alert-light border">
                    No watched movies yet.
                </div>
            }
            else
            {
                <div class="cs-grid-movies">
                    @foreach (var item in watched)
                    {
                        <div>
                            <div class="cs-card movie-card p-0 overflow-hidden h-100">
                                @if (!string.IsNullOrEmpty(item.Movie?.PosterPath))
                                {
                                    <div class="cs-image-shell">
                                        <img src="@item.Movie.PosterPath"
                                             class="cs-poster cs-poster-sm cs-poster-plain"
                                             alt="@item.Movie?.Title"
                                             width="400"
                                             height="320"
                                             loading="lazy"
                                             decoding="async" />
                                    </div>
                                }
                                else
                                {
                                    <div class="cs-poster-placeholder cs-poster-sm rounded-0 border-0 shadow-none">
                                        <span class="display-4">Movie</span>
                                    </div>
                                }

                                <div class="p-4 d-flex flex-column h-100">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0">@item.Movie?.Title</h5>
                                        <span class="cs-badge cs-badge-watched">Watched</span>
                                    </div>

                                    <div class="mb-2">
                                        <span class="cs-badge cs-badge-category me-1">@item.Movie?.Category?.Name</span>
                                        <span class="cs-badge cs-badge-meta">@item.Movie?.Year</span>
                                    </div>

                                    <p class="cs-muted small mb-3 cs-line-clamp-4">
                                        @(string.IsNullOrWhiteSpace(item.Movie?.Description)
                                            ? "No description available."
                                            : item.Movie.Description.Length > 120
                                                ? item.Movie.Description.Substring(0, 120) + "..."
                                                : item.Movie.Description)
                                    </p>

                                    <div class="mt-auto d-grid gap-2">
                                        <form asp-action="MarkToWatch" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn cs-btn cs-btn-neutral w-100">
                                                Move Back to To Watch
                                            </button>
                                        </form>

                                        <a asp-controller="Movie"
                                           asp-action="Details"
                                           asp-route-id="@item.MovieId"
                                           class="btn cs-btn cs-btn-blue w-100">
                                            View Details
                                        </a>

                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn cs-btn cs-btn-dislike w-100">
                                                Remove from Watchlist
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="p-4 pt-0 cs-muted small">
                                    Watched on @(item.WatchedAt?.ToString("dd MMM yyyy") ?? "-")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
